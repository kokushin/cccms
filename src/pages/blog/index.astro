---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// すべてのブログ記事を取得
const allPosts = await getCollection('blog');

// 日付順にソート（新しい順）
const posts = allPosts.sort((a, b) =>
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout title="Blog - My Blog">
  <section class="blog-list-section">
    <h2 class="page-title">すべての記事</h2>

    {posts.length === 0 ? (
      <p class="empty-state">まだ記事がありません。</p>
    ) : (
      <ul class="posts-list">
        {posts.map((post) => (
          <li class="post-item">
            <a href={`/cccms/blog/${post.slug}/`} class="post-link">
              <h3 class="post-title">
                {post.data.title}
              </h3>
              <p class="post-meta">
                <time class="post-date">{post.data.date}</time>
                {post.data.author && <span class="post-author"> • {post.data.author}</span>}
              </p>
              {post.data.description && (
                <p class="post-description">{post.data.description}</p>
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>

  <style>
    .blog-list-section {
      max-width: 48rem;
      margin: 0 auto;
    }

    .page-title {
      font-size: 2rem;
      font-weight: 800;
      margin-bottom: 2rem;
      color: var(--color-text);
      line-height: 1.2;
    }

    @media (min-width: 768px) {
      .page-title {
        font-size: 2.5rem;
        margin-bottom: 2.5rem;
      }
    }

    .empty-state {
      color: var(--color-text-light);
      text-align: center;
      padding: 3rem 1rem;
    }

    .posts-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .post-item {
      margin-bottom: 2rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid var(--color-border);
    }

    @media (min-width: 768px) {
      .post-item {
        margin-bottom: 2.5rem;
        padding-bottom: 2.5rem;
      }
    }

    .post-item:last-child {
      border-bottom: none;
    }

    .post-link {
      display: block;
      text-decoration: none;
      color: inherit;
      transition: transform 0.2s;
    }

    .post-link:hover {
      transform: translateX(4px);
    }

    .post-title {
      font-size: 1.375rem;
      font-weight: 700;
      color: var(--color-primary);
      margin-bottom: 0.75rem;
      line-height: 1.4;
    }

    @media (min-width: 768px) {
      .post-title {
        font-size: 1.75rem;
        margin-bottom: 1rem;
      }
    }

    .post-meta {
      color: var(--color-text-light);
      font-size: 0.875rem;
      margin-bottom: 0.75rem;
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem;
    }

    @media (min-width: 768px) {
      .post-meta {
        font-size: 0.9rem;
        margin-bottom: 1rem;
      }
    }

    .post-date {
      font-weight: 500;
    }

    .post-author {
      font-weight: 500;
    }

    .post-description {
      color: var(--color-text);
      line-height: 1.6;
      font-size: 0.9375rem;
    }

    @media (min-width: 768px) {
      .post-description {
        font-size: 1rem;
        line-height: 1.7;
      }
    }
  </style>
</BaseLayout>
