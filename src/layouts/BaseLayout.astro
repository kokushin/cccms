---
const { title = 'My Blog' } = Astro.props;
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      line-height: 1.6;
      color: #333;
      max-width: 800px;
      margin: 0 auto;
      padding: 20px;
    }

    header {
      border-bottom: 2px solid #333;
      padding-bottom: 20px;
      margin-bottom: 40px;
    }

    h1 {
      font-size: 2em;
      margin-bottom: 10px;
    }

    nav {
      margin-top: 20px;
    }

    nav a {
      color: #0066cc;
      text-decoration: none;
      margin-right: 20px;
    }

    nav a:hover {
      text-decoration: underline;
    }

    main {
      min-height: 60vh;
    }

    footer {
      margin-top: 60px;
      padding-top: 20px;
      border-top: 1px solid #ddd;
      text-align: center;
      color: #666;
    }
  </style>
</head>
<body>
  <header>
    <h1><a href="/cccms/" style="color: inherit; text-decoration: none;">My Blog</a></h1>
    <nav>
      <a href="/cccms/">Home</a>
      <a href="/cccms/blog/">Blog</a>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer>
    <p>&copy; {new Date().getFullYear()} My Blog. Powered by Astro & Claude Code.</p>
  </footer>
</body>
</html>
